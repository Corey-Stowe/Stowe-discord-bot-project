{
  "name": "stowebot-free",
  "version": "1.0.0",
  "description": "StoweBot Free - Open-source Discord music bot with multi-platform support and 24/7 playback",
  "main": "index.js",
  "scripts": {
    "start": "node --no-deprecation index.js",
    "dev": "node --watch --no-deprecation index.js",
    "deploy": "node slashbuilder.js",
    "undeploy": "node resetslash.js",
    "postinstall": "node scripts/patch-ytdlp.js"
  },
  "author": "Stowe",
  "license": "MIT",
  "dependencies": {
    "@discordjs/builders": "^1.10.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.18.0",
    "@distube/direct-link": "^1.0.1",
    "@distube/soundcloud": "^2.0.4",
    "@distube/spotify": "^2.0.2",
    "@distube/yt-dlp": "^2.0.1",
    "axios": "^1.15.0",
    "discord.js": "^14.17.3",
    "distube": "^5.2.3",
    "dotenv": "^16.5.0",
    "opusscript": "^0.0.8",
    "sodium-native": "^5.0.6"
  }
}
