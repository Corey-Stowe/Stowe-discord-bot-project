ADMIN_ID=
DISCORD_TOKEN=
CLIENT_ID=
CLIENT_SECRET=

# Guild ID for fast development deployment (comment out for global deployment)
# Replace with your test server ID for instant deployment during development
# GUILD_ID=YOUR_GUILD_ID_HERE

# YouTube API Configuration
YOUTUBE_API_ENABLED=false
YOUTUBE_PREFER_API=false

# YouTube Mode Configuration (New 5-Mode System)
# Only one of these should be true at a time
YOUTUBE_AUTO_COOKIE=true
YOUTUBE_COOKIE_ONLY=false
YOUTUBE_DEFAULT_MODE=false

# YouTube Cookie Modes (Legacy - for backward compatibility):
# auto-cookie - Automatically gets and rotates safe cookies (recommended)
# cookie-only - Only uses user-provided custom cookies (restricted mode)
# cookies - Legacy mode (same as auto-cookie)
YOUTUBE_COOKIE_MODE=auto-cookie

# Spotify API Credentials
# Get these from: https://developer.spotify.com/dashboard/applications
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
BOT_LANGUAGE=en
# Available: en (English), vi (Vietnamese), ja (Japanese)
# Cache Management Configuration
CACHE_MAX_SIZE_MB=1024
CACHE_CLEANUP_COUNT=5
CACHE_AUTO_CLEANUP=true