# ==============================================
# StoweBot Free - Configuration
# ==============================================
# Copy this file to .env and fill in your values

# ==========================================
# Required Settings
# ==========================================
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id
ADMIN_ID=your_discord_user_id

# Optional: Set for faster command registration (guild-specific)
# Without this, commands deploy globally and take up to 1 hour
GUILD_ID=

# ==========================================
# Spotify Integration (Optional)
# Get credentials at: https://developer.spotify.com/dashboard
# ==========================================
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ==========================================
# Last.fm Integration (Optional - enhances music recommendations)
# Get credentials at: https://www.last.fm/api/account/create
# ==========================================
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# ==========================================
# Language Settings
# Available: en (English), vi (Vietnamese), ja (Japanese)
# ==========================================
BOT_LANGUAGE=en

# ==========================================
# Cache Management
# ==========================================
CACHE_MAX_SIZE_MB=500
CACHE_CLEANUP_COUNT=5
CACHE_AUTO_CLEANUP=true
